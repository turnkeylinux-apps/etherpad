#!/bin/bash -e
# regenerate etherpad secrets and mysql password

. /etc/default/inithooks

NODEAPP=/opt/etherpad
CONF=/etc/etherpad/settings.json
APIKEY=$(mcookie)
SESSIONKEY=$(mcookie)
PASSWORD=$(mcookie)

printf '%s' "$APIKEY" > "$NODEAPP/APIKEY.txt"
printf '%s' "$SESSIONKEY" > "$NODEAPP/SESSIONKEY.txt"

python3 - "$CONF" "$PASSWORD" <<'PY'
import json
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
password = json.dumps(sys.argv[2])
settings = path.read_text()
pattern = r'("dbSettings"\s*:\s*\{.*?"password"\s*:\s*)"(?:[^"\\]|\\.)*"'
settings, count = re.subn(pattern, lambda match: match.group(1) + password,
                          settings, count=1, flags=re.DOTALL)
if count != 1:
    raise SystemExit("Etherpad database password setting is missing")
path.write_text(settings)
PY

chown root:etherpad "$NODEAPP/APIKEY.txt" "$NODEAPP/SESSIONKEY.txt"
chmod 0640 "$NODEAPP/APIKEY.txt" "$NODEAPP/SESSIONKEY.txt"
chown etherpad:etherpad "$CONF"
chmod 0660 "$CONF"

$INITHOOKS_PATH/bin/mysqlconf.py --user=etherpad --pass="$PASSWORD"

systemctl enable etherpad.service
